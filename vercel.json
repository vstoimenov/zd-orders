{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/nekorekten",
      "schedule": "30 3 * * *"
    }
  ],
  "functions": {
    "api/cron/refresh.js": {
      "maxDuration": 60
    },
    "api/cron/nekorekten.js": {
      "maxDuration": 60
    },
    "api/cb/webhook.js": {
      "maxDuration": 30
    },
    "api/admin/[route].js": {
      "maxDuration": 60
    },
    "api/demo/[route].js": {
      "maxDuration": 30,
      "includeFiles": "db/migrations/**"
    },
    "api/wa/webhook.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(checkout|kurier).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/demo(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/confirm(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(oferta|landing/oferta.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/p/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/integrations/woocommerce.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/integrations/(.*).zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/data-deletion",
      "has": [
        {
          "type": "host",
          "value": "ordyx.eu"
        }
      ],
      "destination": "/landing/data-deletion.html"
    },
    {
      "source": "/oferta",
      "has": [
        {
          "type": "host",
          "value": "ordyx.eu"
        }
      ],
      "destination": "/landing/oferta.html"
    },
    {
      "source": "/dev",
      "has": [
        {
          "type": "host",
          "value": "ordyx.eu"
        }
      ],
      "destination": "/landing/dev.html"
    },
    {
      "source": "/terms",
      "has": [
        {
          "type": "host",
          "value": "ordyx.eu"
        }
      ],
      "destination": "/landing/terms.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "ordyx.eu"
        }
      ],
      "destination": "/landing/privacy.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/admin/icon-192.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/admin/apple-touch-icon.png"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ordyx.eu"
        }
      ],
      "destination": "/landing/index.html"
    },
    {
      "source": "/p/:t",
      "destination": "/confirm/index.html"
    },
    {
      "source": "/kurier.js",
      "destination": "/checkout.js"
    },
    {
      "source": "/demo/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/demo/manifest.webmanifest",
      "destination": "/admin/manifest-demo.webmanifest"
    },
    {
      "source": "/demo/:path*",
      "destination": "/admin/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/demo/",
      "has": [
        {
          "type": "host",
          "value": "kurier.profitbrand.online"
        }
      ],
      "destination": "https://zd-orders.vercel.app/demo/",
      "permanent": false
    },
    {
      "source": "/admin/",
      "has": [
        {
          "type": "host",
          "value": "zd-orders.vercel.app"
        }
      ],
      "destination": "https://app.ordyx.eu/admin/",
      "permanent": false
    },
    {
      "source": "/demo",
      "has": [
        {
          "type": "host",
          "value": "kurier.profitbrand.online"
        }
      ],
      "destination": "https://zd-orders.vercel.app/demo/",
      "permanent": false
    },
    {
      "source": "/demo/:path*",
      "has": [
        {
          "type": "host",
          "value": "kurier.profitbrand.online"
        }
      ],
      "destination": "https://zd-orders.vercel.app/demo/:path*",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "zd-orders.vercel.app"
        }
      ],
      "destination": "https://app.ordyx.eu/admin/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "zd-orders.vercel.app"
        }
      ],
      "destination": "https://app.ordyx.eu/admin/:path*",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "kurier.profitbrand.online"
        }
      ],
      "destination": "https://app.ordyx.eu/admin/",
      "permanent": false
    },
    {
      "source": "/admin/",
      "has": [
        {
          "type": "host",
          "value": "kurier.profitbrand.online"
        }
      ],
      "destination": "https://app.ordyx.eu/admin/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "kurier.profitbrand.online"
        }
      ],
      "destination": "https://app.ordyx.eu/admin/:path*",
      "permanent": false
    },
    {
      "source": "/demo",
      "has": [
        {
          "type": "host",
          "value": "app.ordyx.eu"
        }
      ],
      "destination": "https://zd-orders.vercel.app/demo/",
      "permanent": false
    },
    {
      "source": "/demo/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.ordyx.eu"
        }
      ],
      "destination": "https://zd-orders.vercel.app/demo/:path*",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.ordyx.eu"
        }
      ],
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ordyx.eu"
        }
      ],
      "destination": "https://ordyx.eu/$1",
      "permanent": true
    },
    {
      "source": "/admin(.*)",
      "has": [
        {
          "type": "host",
          "value": "ordyx.eu"
        }
      ],
      "destination": "https://app.ordyx.eu/admin$1",
      "permanent": false
    },
    {
      "source": "/demo(.*)",
      "has": [
        {
          "type": "host",
          "value": "ordyx.eu"
        }
      ],
      "destination": "https://zd-orders.vercel.app/demo/",
      "permanent": false
    },
    {
      "source": "/demo",
      "destination": "/demo/",
      "permanent": false
    }
  ]
}
