{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/nekorekten",
      "schedule": "30 3 * * *"
    }
  ],
  "functions": {
    "api/cron/refresh.js": {
      "maxDuration": 60
    },
    "api/cron/nekorekten.js": {
      "maxDuration": 60
    },
    "api/cb/webhook.js": {
      "maxDuration": 30
    },
    "api/admin/[route].js": {
      "maxDuration": 60
    },
    "api/demo/[route].js": {
      "maxDuration": 30,
      "includeFiles": "db/migrations/**"
    }
  },
  "headers": [
    {
      "source": "/(checkout|kurier).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/demo(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/kurier.js",
      "destination": "/checkout.js"
    },
    {
      "source": "/demo/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/demo/:path*",
      "destination": "/admin/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/demo",
      "destination": "/demo/",
      "permanent": false
    }
  ]
}
