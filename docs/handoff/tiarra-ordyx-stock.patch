diff --git a/lib/ordyx-stock.ts b/lib/ordyx-stock.ts
new file mode 100644
index 0000000..33d3b8c
--- /dev/null
+++ b/lib/ordyx-stock.ts
@@ -0,0 +1,48 @@
+import { after } from 'next/server'
+import { sql } from '@/lib/db'
+
+export type StockRow = { name: string; sku: string; stock: number }
+
+/** Every tracked stock (not null), named the way the orders reach Ordyx: "Title — Variant", or the title of a product without variants. */
+export async function stockRows(): Promise<StockRow[]> {
+  return sql<StockRow[]>`
+    select p.title || ' — ' || v.name as name, v.sku, v.stock
+      from store.variants v join store.products p on p.id = v.product_id
+     where v.stock is not null
+    union all
+    select p.title as name, '' as sku, p.stock
+      from store.products p
+     where p.stock is not null and not exists (select 1 from store.variants v where v.product_id = p.id)`
+}
+
+const BATCH = 2000
+
+/** Sends all stock to Ordyx. Never throws: a send that is lost is made up by the next one and by the daily cron. */
+export async function pushStockToOrdyx(): Promise<boolean> {
+  const key = process.env.ORDYX_API_KEY
+  if (!key) return false
+  try {
+    const items = await stockRows()
+    for (let i = 0; i < items.length; i += BATCH) {
+      const response = await fetch('https://app.ordyx.eu/api/orders', {
+        method: 'POST',
+        headers: {
+          Authorization: `Bearer ${key}`, 'Content-Type': 'application/json',
+          'X-Ordyx-Site': JSON.stringify({ mode: 'checkout', version: 'tiarra-1' }),
+        },
+        body: JSON.stringify({ type: 'stock', source: 'api', items: items.slice(i, i + BATCH) }),
+        signal: AbortSignal.timeout(8000),
+      })
+      if (!response.ok) { console.error('Ordyx stock push failed', response.status); return false }
+    }
+    return true
+  } catch (error) {
+    console.error('Ordyx stock push failed', error)
+    return false
+  }
+}
+
+/** After the response (Next.js `after`); outside a request (scripts, tests) it simply starts. Never throws, never delays the answer. */
+export function pushStockLater(): void {
+  try { after(() => pushStockToOrdyx()) } catch { void pushStockToOrdyx() }
+}
diff --git a/tests/unit/ordyx-stock.test.ts b/tests/unit/ordyx-stock.test.ts
new file mode 100644
index 0000000..53cb567
--- /dev/null
+++ b/tests/unit/ordyx-stock.test.ts
@@ -0,0 +1,49 @@
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+const mocks = vi.hoisted(() => ({ sql: vi.fn() }))
+vi.mock('@/lib/db', () => ({ sql: mocks.sql }))
+import { pushStockLater, pushStockToOrdyx, stockRows } from '@/lib/ordyx-stock'
+
+const ROWS = [{ name: 'Парфюм — 50 ml', sku: 'P-50', stock: 3 }, { name: 'Крем', sku: '', stock: 0 }]
+
+beforeEach(() => {
+  vi.stubEnv('ORDYX_API_KEY', 'test-only')
+  mocks.sql.mockReset().mockResolvedValue(ROWS)
+  vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response('{"ok":true}')))
+})
+afterEach(() => { vi.unstubAllGlobals(); vi.unstubAllEnvs() })
+
+it('names variants "Title — Variant" like the orders, skips untracked stock and parents of variants', async () => {
+  await stockRows()
+  const query = mocks.sql.mock.calls[0][0].join('')
+  expect(query).toContain("p.title || ' — ' || v.name as name")
+  expect(query).toContain('v.stock is not null')
+  expect(query).toContain('p.stock is not null and not exists (select 1 from store.variants v where v.product_id = p.id)')
+})
+
+it('sends all stock to Ordyx with the shop key', async () => {
+  expect(await pushStockToOrdyx()).toBe(true)
+  const [url, init] = vi.mocked(fetch).mock.calls[0]
+  expect(url).toBe('https://app.ordyx.eu/api/orders')
+  expect((init!.headers as Record<string, string>).Authorization).toBe('Bearer test-only')
+  expect(JSON.parse(init!.body as string)).toEqual({ type: 'stock', source: 'api', items: ROWS })
+})
+
+it('does nothing without a key', async () => {
+  vi.stubEnv('ORDYX_API_KEY', '')
+  expect(await pushStockToOrdyx()).toBe(false)
+  expect(fetch).not.toHaveBeenCalled()
+})
+
+it('never throws: an error answer or a timeout is false', async () => {
+  vi.spyOn(console, 'error').mockImplementation(() => {})
+  vi.mocked(fetch).mockResolvedValueOnce(new Response('{}', { status: 500 }))
+  expect(await pushStockToOrdyx()).toBe(false)
+  vi.mocked(fetch).mockRejectedValueOnce(new Error('Timeout'))
+  expect(await pushStockToOrdyx()).toBe(false)
+})
+
+it('outside a request the later push still runs and never throws', async () => {
+  expect(() => pushStockLater()).not.toThrow()
+  await vi.waitFor(() => expect(fetch).toHaveBeenCalledTimes(1))
+})
